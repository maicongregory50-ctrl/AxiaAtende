<service>
  <id>axiaatende-recepcionista</id>
  <name>AxiaAtende - Recepcionista</name>
  <description>AxiaAtende - o recepcionista do WhatsApp 49 3664 0121 (127.0.0.1:8008, publicado pelo Funnel na 443). O unico processo que fala com a Meta. #950</description>
  <executable>C:\AxiaAtende\.venv\Scripts\python.exe</executable>
  <arguments>-m uvicorn backend.recepcionista:app --host 127.0.0.1 --port 8008 --no-access-log --proxy-headers --forwarded-allow-ips 127.0.0.1</arguments>
  <!-- Sem log de acesso: o aperto de mao da Meta traz o token de verificacao no endereco, e ele
       iria parar no arquivo. O que chega fica no banco (eventos_meta), e a saude diz o ultimo. -->
  <workingdirectory>C:\AxiaAtende</workingdirectory>
  <startmode>Automatic</startmode>
  <depend>axiaatende-postgres</depend>
  <!-- O processo que a internet alcanca roda com o MENOR usuario do Windows (o mesmo desenho da
       vitrine do AxiaMarketing). Le o codigo, o ambiente Python e o .env.recepcionista; escreve
       so o proprio log. Nao le o .env.secrets.
       SINTAXE DO WinSW 2.12 (o .exe daqui): domain + user. O username e da 3.x e a 2.12 o ignora
       calada, instalando como LocalSystem.
       NUNCA dois hifens seguidos dentro de comentario: XML invalido, o WinSW nao sobe. -->
  <serviceaccount>
    <domain>NT AUTHORITY</domain>
    <user>LocalService</user>
  </serviceaccount>
  <env name="AXIAATENDE_AMBIENTE" value="producao"/>
  <env name="AXIAATENDE_PROCESSO" value="recepcionista"/>
  <env name="AXIAATENDE_LOGS" value="C:\Logs\AxiaAtende\recepcionista"/>
  <!-- #1188: o porteiro dos avisos internos (texto dentro das 24 h; fora, a reabertura com o Ver).
       NASCE off. So vira on depois de o modelo reabrir_avisos estar APROVADO na Meta; ligado antes,
       a reabertura falha e ninguem recebe o aviso. Para desligar: voltar a off e reiniciar. -->
  <env name="AXIAATENDE_PORTEIRO" value="off"/>
  <logpath>C:\Logs\AxiaAtende\recepcionista</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>3</keepFiles>
  </log>
  <onfailure action="restart" delay="5 sec"/>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
</service>
